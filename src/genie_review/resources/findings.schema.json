{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "impact_summary",
    "findings",
    "injection_attempts",
    "ontology_verdicts"
  ],
  "properties": {
    "impact_summary": {
      "type": "string"
    },
    "injection_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "severity",
          "file",
          "line",
          "title",
          "explanation",
          "evidence",
          "impact",
          "suggestion",
          "confidence"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestion": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "ontology_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "verdict",
          "reasoning",
          "file",
          "line",
          "finding_title"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "conflict",
              "no_conflict",
              "unclear"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "finding_title": {
            "type": "string"
          }
        }
      }
    }
  }
}
