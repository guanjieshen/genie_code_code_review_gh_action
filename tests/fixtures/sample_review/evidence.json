  "ev:uc:main.shop.gold_customer_ltv:metadata": {
    "exists": true,
    "type": "VIEW",
    "comment": "Customer lifetime value. Used by the Customer 360 dashboard.",
    "owner": "data-eng@example.com",
    "columns": [
      {
        "name": "cust_id",
        "type": "bigint",
        "comment": "FK to bronze_customers.cust_id"
      },
      {
        "name": "segment",
        "type": "string",
        "comment": "SMB | MID | ENT"
      },
      {
        "name": "ltv",
        "type": "decimal(22,2)",
        "comment": null
      }
    ],
    "view_definition": "SELECT o.cust_id, c.segment, SUM(o.net_amount) AS ltv\nFROM main.shop.silver_orders o\nJOIN main.shop.bronze_customers c ON cast(o.cust_id AS STRING) = c.cust_id\nWHERE o.status <> 'CANCELLED' AND NOT o.is_test GROUP BY o.cust_id, c.segment"
  },
